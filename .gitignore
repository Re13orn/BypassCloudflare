# Build output
extension/target/

# NOTE: extension/src/main/resources/bin/ holds pre-compiled cfproxy binaries that
# ARE committed, so the BApp Store auto-build (plain `mvn package` at the root)
# works without a Go toolchain. Rebuild them with ./build.sh after Go changes.

# cfproxy compiled binary & runtime data (certs/keys regenerate on demand)
cfproxy/cfproxy
cfproxy/cfproxy.new
cfproxy/data/

